NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DATABASE_POOL_MAX=10
ORBIT_OWNER_ACCOUNT_ID=00000000-0000-4000-8000-000000000000
# Development-only fallback; production requires the immutable account UUID.
# ORBIT_OWNER_EMAIL=owner@example.com
TRUST_PROXY_HOPS=1
# Comma-separated browser origins allowed to call /health and open game
# WebSockets. Use the assigned Pages hostname; a project-scoped wildcard may be
# added for preview deployments, for example:
# PUBLIC_CLIENT_ORIGINS=https://orbit-ops.pages.dev,https://*.orbit-ops.pages.dev
PUBLIC_CLIENT_ORIGINS=
ALLOW_SINGLE_PLAYER_TESTING=false
# Subdivision is bundled under games/subdivision but keeps an entirely separate
# database and secret namespace from Orbit Ops.
SUBDIVISION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SUBDIVISION_ADMIN_TOKEN=replace-with-a-long-random-token
SUBDIVISION_DEVICE_SECRET=replace-with-a-long-random-secret
# Optional local override for development only.
# SUBDIVISION_GAME_ROOT=/absolute/path/to/Orbit-Ops-Subdivision
# Legacy JIMS_* names remain accepted during migration but should not be used for
# new deployments.
# Break-glass moderation over HTTP. Unset means the /admin route does not exist.
ORBIT_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Identifies this process in the shared room-code directory. Defaults to a random
# id per boot, which is right unless you run more than one instance.
# ORBIT_INSTANCE_ID=orbit-render-1
