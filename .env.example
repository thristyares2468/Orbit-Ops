NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_SSL=true
DATABASE_POOL_MAX=10
ALLOW_SINGLE_PLAYER_TESTING=false
JIMS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JIMS_ADMIN_TOKEN=replace-with-a-long-random-token
JIMS_DEVICE_SECRET=replace-with-a-long-random-secret
# Optional local override. Render obtains the game during `npm run jims:sync`.
# JIMS_GAME_ROOT=/absolute/path/to/fpsshooterserver
