{
  "name": "orbit-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit Ops - a server-authoritative 3D social deduction game aboard the O.S.V. Meridian.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "assets:inventory": "node scripts/generateAssetCatalog.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check server/gameServer.js && node --check public/src/main.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "pg": "8.22.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "three": "0.185.1"
  }
}
