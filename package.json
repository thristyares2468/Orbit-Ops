{
  "name": "orbit-ops",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Orbit Ops - a server-authoritative 2D social deduction game aboard the O.S.V. Meridian.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "subdivision:install": "npm ci --omit=dev --prefix games/subdivision",
    "subdivision:check": "node --check games/subdivision/server.js",
    "assets:inventory": "node scripts/generateAssetCatalog.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && find server public/src database scripts -type f -name '*.js' -exec node --check {} ';' && find scripts -type f -name '*.mjs' -exec node --check {} ';' && pnpm run subdivision:check"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "http-proxy": "1.18.1",
    "phaser": "4.2.1",
    "pg": "8.22.0",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  }
}
